{
  "manifest_version": 3,
  "name": "Polaris: AI Chat Navigator — Smart Headings & Quick Jump",
  "version": "0.67.1",
  "version_name": "0.67.1(268)",
  "description": "Show heading markers for supported AI web answers and jump to headings from the right edge.",
  "icons": {
    "16": "icons/gpt-voyager-icon-16.png",
    "32": "icons/gpt-voyager-icon-32.png",
    "48": "icons/gpt-voyager-icon-48.png",
    "128": "icons/gpt-voyager-icon-128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "sidePanel",
    "scripting"
  ],
  "action": {
    "default_title": "Open Polaris"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://grok.com/*",
    "https://manus.im/*",
    "https://chat.deepseek.com/*",
    "https://www.doubao.com/*",
    "https://www.kimi.com/*",
    "https://kimi.com/*",
    "https://www.qianwen.com/*",
    "https://qianwen.com/*",
    "https://yb.tencent.com/*",
    "https://yuanbao.tencent.com/*",
    "https://diandian.xiaohongshu.com/*",
    "https://www.xiaohongshu.com/*",
    "https://www.askdiandian.com/*",
    "https://www.diandianlife.top/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/gpt-voyager-icon-96.png",
        "icons/loader-2.svg",
        "icons/platform-chatgpt.png",
        "icons/platform-claude.png",
        "icons/platform-gemini.png",
        "icons/platform-grok.png",
        "icons/platform-doubao.png",
        "icons/platform-kimi.png",
        "icons/platform-qianwen.png",
        "icons/platform-yuanbao.png",
        "icons/platform-xiaohongshu.png",
        "icons/platform-manus.png",
        "icons/platform-deepseek.ico",
        "src/route-bridge.js"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://manus.im/*",
        "https://chat.deepseek.com/*",
        "https://www.doubao.com/*",
        "https://www.kimi.com/*",
        "https://kimi.com/*",
        "https://www.qianwen.com/*",
        "https://qianwen.com/*",
        "https://yb.tencent.com/*",
        "https://yuanbao.tencent.com/*",
        "https://diandian.xiaohongshu.com/*",
        "https://www.xiaohongshu.com/*",
        "https://www.askdiandian.com/*",
        "https://www.diandianlife.top/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://grok.com/*",
        "https://manus.im/*",
        "https://chat.deepseek.com/*",
        "https://www.doubao.com/*",
        "https://www.kimi.com/*",
        "https://kimi.com/*",
        "https://www.qianwen.com/*",
        "https://qianwen.com/*",
        "https://yb.tencent.com/*",
        "https://yuanbao.tencent.com/*",
        "https://diandian.xiaohongshu.com/*",
        "https://www.xiaohongshu.com/*",
        "https://www.askdiandian.com/*",
        "https://www.diandianlife.top/*"
      ],
      "js": [
        "src/i18n.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
