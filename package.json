{
  "name": "polaris-ai-chat-navigator",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:edge": "wxt build -b edge",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "zip:edge": "wxt zip -b edge",
    "dev": "wxt",
    "prepare": "node scripts/prepare.js",
    "check": "node scripts/check.js",
    "test": "node --test",
    "billing:dev": "wrangler dev --config workers/license-test/wrangler.jsonc --port 4318 --compatibility-date 2026-05-15",
    "billing:check": "node --test workers/license-test/test/*.test.js",
    "billing:deploy": "wrangler deploy --config workers/license-test/wrangler.jsonc"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "26.1.0",
    "tailwindcss": "^4.3.3",
    "vite": "7.3.6",
    "web-ext": "10.7.0",
    "wrangler": "4.92.0",
    "wxt": "0.21.4"
  },
  "dependencies": {
    "iconify-mcp-server": "^1.0.4"
  }
}
